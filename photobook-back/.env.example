APP_ENV=local
API_HOST=0.0.0.0
API_PORT=4000
AUTH_CHALLENGE_RATE_LIMIT=5
AUTH_CHALLENGE_RATE_WINDOW_SECONDS=600
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_COOKIE_NAME=photobook_session
AUTH_FAKE_OTP_CODE=246810
AUTH_HASH_SECRET=photobook-local-auth-secret-change-me
AUTH_MAX_VERIFY_ATTEMPTS=5
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_SECONDS=2592000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

DATABASE_URL=postgresql://photobook:photobook_local@localhost:5432/photobook?schema=public

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=photobook-local
STORAGE_ACCESS_KEY=photobook-local
STORAGE_SECRET_KEY=photobook-local-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PREVIEW_URL_TTL_SECONDS=900
STORAGE_UPLOAD_URL_TTL_SECONDS=600
