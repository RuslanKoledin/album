{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@photobook/config": ["packages/config/src/index.ts"],
      "@photobook/contracts": ["packages/contracts/src/index.ts"],
      "@photobook/database": ["packages/database/src/index.ts"],
      "@photobook/domain": ["packages/domain/src/index.ts"],
      "@api/*": ["apps/api/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "build",
    "coverage",
    "node_modules",
    "packages/contracts/artifacts"
  ]
}
