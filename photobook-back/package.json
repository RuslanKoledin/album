{
  "name": "photobook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && node scripts/copy-contracts.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm contracts:lint && pnpm test && pnpm build",
    "contracts:lint": "redocly lint packages/contracts/artifacts/openapi.yaml --extends=recommended",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "dev": "tsx watch apps/api/src/main.ts",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up -d --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate --config packages/database/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config packages/database/prisma.config.ts",
    "prisma:validate": "prisma validate --config packages/database/prisma.config.ts",
    "seed:reference": "tsx scripts/seed-reference-data.ts",
    "start": "node --enable-source-maps build/apps/api/src/main.js",
    "storage:bootstrap": "tsx scripts/bootstrap-storage.ts",
    "test": "vitest run",
    "test:database": "node scripts/run-database-tests.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "3.1093.0",
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@redocly/cli": "2.39.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "yaml": "2.9.0"
  }
}
